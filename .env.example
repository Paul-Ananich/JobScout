# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobscout?schema=public"

# Gmail API OAuth2 credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/
GMAIL_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-client-secret"
GMAIL_REDIRECT_URI="http://localhost:3000/oauth/callback"
GMAIL_REFRESH_TOKEN="your-refresh-token"

# OpenAI API for job analysis
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# Telegram Bot
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# Application settings
LOG_LEVEL="info"
NODE_ENV="development"

# Worker settings
EMAIL_POLL_INTERVAL_MS="60000"
MAX_JOBS_PER_BATCH="10"
